GITHUB_TOKEN=
LIBRARIES_IO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# No-key Reddit JSON scans these subreddits even when Reddit OAuth credentials are empty.
INTERNET_RADAR_REDDIT_SUBREDDITS=LocalLLaMA,MachineLearning,OpenAI,learnpython,webdev
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
INTERNET_RADAR_EMAIL_TO=
INTERNET_RADAR_EMAIL_FROM=
INTERNET_RADAR_NTFY_TOPIC=
INTERNET_RADAR_NTFY_SERVER=https://ntfy.sh
GROQ_API_KEY=
GEMINI_API_KEY=
PRODUCTHUNT_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
CRUNCHBASE_API_KEY=
COHERE_API_KEY=
HACKEREARTH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
INTERNET_RADAR_DB=data/radar.sqlite
INTERNET_RADAR_ALERT_OUTBOX_DB=data/radar.sqlite
INTERNET_RADAR_ALERT_OUTBOX_RETRY_LIMIT=25
INTERNET_RADAR_SCHEDULER_DB=data/scheduler_jobs.sqlite
INTERNET_RADAR_SCHEDULER_HEARTBEAT_MAX_AGE_MINUTES=30
INTERNET_RADAR_USE_LIVE=1
# When set to 1, the pipeline makes one bounded LLM JSON call for the morning insight.
INTERNET_RADAR_ENABLE_LLM_ANALYSIS=0
INTERNET_RADAR_DISPATCH_ALERTS=0
INTERNET_RADAR_USER_AGENT=internet-radar-v2/0.1
INTERNET_RADAR_FREE_ONLY=1
INTERNET_RADAR_ENABLE_CRAWLER=1
INTERNET_RADAR_CRAWL_SEEDS=config/crawl_seeds.yaml
INTERNET_RADAR_CRAWLER_MAX_TOTAL_PAGES=200
INTERNET_RADAR_CRAWLER_MAX_PAGES_PER_SEED=20
INTERNET_RADAR_CRAWLER_RESPECT_ROBOTS=1
INTERNET_RADAR_CRAWLER_TIMEOUT_SECONDS=20
INTERNET_RADAR_SIGNAL_MAX_AGE_DAYS=14
INTERNET_RADAR_PAYLOAD_CACHE=data/latest_payload.json
INTERNET_RADAR_BACKGROUND_REFRESH_SECONDS=3600
INTERNET_RADAR_STORAGE_BACKEND=sqlite
INTERNET_RADAR_ANALYTICS_BACKEND=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=signals
INTERNET_RADAR_VECTOR_BACKEND=auto
# Set INTERNET_RADAR_VECTOR_BACKEND=gemini when GEMINI_API_KEY is configured and you want provider-backed semantic search without ChromaDB.
INTERNET_RADAR_CHROMA_PATH=data/chroma
